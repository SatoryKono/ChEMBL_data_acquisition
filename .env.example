# Copy this file to .env and adjust the contact information.
# The application automatically loads variables exported in the shell.
# Use dedicated env vars for API contact details to avoid committing them.
CHEMBL_DA_BASE_PATH="./data"
CHEMBL_DA__SOURCES__CHEMBL__API__USER_AGENT="chembl-da/1.0 (mailto:you@example.com)"
CHEMBL_DA__SOURCES__OPENALEX__MAILTO="you@example.com"
CHEMBL_DA__SOURCES__CROSSREF__MAILTO="you@example.com"
