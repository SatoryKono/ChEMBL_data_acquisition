# Example environment configuration for local development.
# Copy this file to `.env` and adjust the values for your workspace.

# Base directory for downloads, caches and generated exports.
CHEMBL_DA_BASE_PATH=./data

# Logging verbosity for CLI utilities (DEBUG, INFO, WARNING, ERROR).
CHEMBL_DA_LOG_LEVEL=INFO

# API contact information. Replace the placeholder with your team's email.
CHEMBL_DA_BASE=https://www.ebi.ac.uk/chembl/api/data
CHEMBL_DA_PUBCHEM_USER_AGENT=chembl-da/1.0 (mailto:team@example.org)
CHEMBL_DA_OPENALEX_MAILTO=team@example.org
CHEMBL_DA_CROSSREF_MAILTO=team@example.org

# Rate-limiter defaults aligned with config/config.yaml.
CHEMBL_DA_RPS=20
CHEMBL_DA_BURST=20
CHEMBL_DA_GLOBAL_RPS=100
CHEMBL_DA_GLOBAL_BURST=100

# Cache configuration mirroring the defaults in config/config.yaml.
CHEMBL_DA_CACHE_TTL=3600
CHEMBL_DA_CACHE_MAXSIZE=1024
CHEMBL_DA_LIMITER_CACHE_TTL=600
CHEMBL_DA_LIMITER_CACHE_MAXSIZE=128
